
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<style>
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif}
#wrap{min-height:100vh;padding:1rem;border-radius:12px;background:linear-gradient(135deg,#0055cc 0%,#3a7bd5 35%,#a0b4c8 70%,#d4dce4 100%)}
#wrap.final-bg{background:linear-gradient(160deg,#0a1a3a 0%,#0d5c3a 40%,#4a9e20 70%,#c8d400 100%)}
.card{background:rgba(255,255,255,0.92);border-radius:14px;padding:1rem;border:0.5px solid rgba(255,255,255,0.4)}
.start-screen,.level-complete{text-align:center;padding:1.5rem .5rem}
.big-icon{font-size:64px;margin-bottom:.6rem;display:block;animation:popIn .5s cubic-bezier(.34,1.56,.64,1)}
@keyframes popIn{0%{transform:scale(0) rotate(-10deg);opacity:0}100%{transform:scale(1) rotate(0deg);opacity:1}}
@keyframes slideIn{0%{transform:translateY(14px);opacity:0}100%{transform:translateY(0);opacity:1}}
@keyframes shake{0%,100%{transform:translateX(0)}20%{transform:translateX(-5px)}40%{transform:translateX(5px)}60%{transform:translateX(-3px)}80%{transform:translateX(3px)}}
@keyframes pulse{0%,100%{transform:scale(1)}50%{transform:scale(1.05)}}
@keyframes float{0%,100%{transform:translateY(0)}50%{transform:translateY(-8px)}}
@keyframes confettiFall{0%{transform:translateY(-20px) rotate(0deg);opacity:1}100%{transform:translateY(80px) rotate(360deg);opacity:0}}
@keyframes starPop{0%{transform:scale(0);opacity:0}60%{transform:scale(1.3);opacity:1}100%{transform:scale(1);opacity:1}}
.title{font-size:20px;font-weight:600;color:#fff;margin-bottom:.35rem;text-shadow:0 1px 3px rgba(0,0,0,.3)}
.sub{font-size:13px;color:#e8eef5;margin-bottom:1rem;line-height:1.5;text-shadow:0 1px 2px rgba(0,0,0,.2)}
.start-btn{padding:.75rem 2rem;border:none;border-radius:10px;background:#3a3a3a;color:#fff;font-size:16px;cursor:pointer;font-weight:600;touch-action:manipulation}
.start-btn:active{transform:scale(.97)}
.header{display:flex;align-items:center;gap:8px;margin-bottom:.75rem}
.lvl-badge{font-size:11px;font-weight:500;padding:4px 10px;border-radius:20px;background:rgba(255,255,255,.25);color:#fff;border:1px solid rgba(255,255,255,.4)}
.score-pill{margin-left:auto;font-size:12px;padding:4px 9px;border-radius:20px;background:rgba(255,255,255,.2);color:#fff;font-weight:500;border:1px solid rgba(255,255,255,.35)}
.timer-row{display:flex;align-items:center;gap:8px;margin-bottom:.6rem}
.timer-label{font-size:13px;font-weight:600;min-width:32px}
.timer-bar-wrap{flex:1;height:8px;background:rgba(255,255,255,.2);border-radius:4px;overflow:hidden}
.timer-bar{height:100%;border-radius:4px;transition:width .9s linear,background .5s}
.q-num{font-size:11px;color:#334d66;margin-bottom:.3rem;font-weight:500}
.q-text{font-size:14px;font-weight:600;color:#0a2535;line-height:1.45;animation:slideIn .3s ease}
.opts{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:.85rem}
.opt{padding:.7rem .65rem;border-radius:10px;border:2px solid #111;background:#1c1c1c;font-size:13px;color:#fff;cursor:pointer;text-align:left;line-height:1.35;font-family:inherit;font-weight:500;touch-action:manipulation;min-height:52px;transition:all .15s}
.opt:active{transform:scale(.97)}
.opt:disabled{cursor:default}
.opt.correct{background:#1a5c28;border-color:#27a74a;color:#fff;animation:pulse .4s ease}
.opt.wrong{background:#7b1717;border-color:#c0392b;color:#fff;animation:shake .35s ease}
.opt.reveal{background:#1a5c28;border-color:#27a74a;color:#fff}
.feedback{margin-top:.75rem;padding:.65rem .85rem;border-radius:10px;font-size:13px;line-height:1.45;animation:slideIn .25s ease;font-family:inherit}
.feedback.ok{background:#c8ecd4;color:#0a3a18}
.feedback.ko{background:#fcd4d4;color:#5c0a0a}
.feedback.timeout{background:#fff0b3;color:#4a3500}
.next-btn{width:100%;margin-top:.65rem;padding:.7rem;border-radius:10px;border:2px solid #111;background:#1c1c1c;color:#fff;font-size:14px;cursor:pointer;font-family:inherit;font-weight:500;touch-action:manipulation}
.next-btn:active{transform:scale(.97)}
.li-row{display:flex;gap:8px;justify-content:center;margin-bottom:1rem}
.li{width:32px;height:32px;border-radius:50%;border:2px solid #aaa;display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:600;color:#fff;background:#3a3a3a}
.li.done{background:#fff;border-color:#fff;color:#0055cc}
.li.active{border-color:#fff;color:#fff;background:#555}
.lvl-score{font-size:14px;color:#e8eef5;font-weight:500;margin-bottom:1rem}
.cont-btn{padding:.75rem 2rem;border-radius:10px;border:none;background:#3a3a3a;color:#fff;font-size:15px;cursor:pointer;font-weight:600;font-family:inherit;touch-action:manipulation}
.cont-btn:active{transform:scale(.97)}
.final{text-align:center;padding:1.25rem .5rem;position:relative;overflow:hidden}
.final-icon{font-size:72px;display:block;animation:float 2s ease-in-out infinite}
.final-title{font-size:20px;font-weight:700;color:#fff;margin:.4rem 0 .2rem;text-shadow:0 2px 8px rgba(0,0,0,.4)}
.final-sub{font-size:13px;color:rgba(255,255,255,.92);margin-bottom:.75rem;font-family:inherit}
.stars{font-size:26px;letter-spacing:4px;margin:.4rem 0;animation:starPop .6s ease forwards}
.score-circle{width:110px;height:110px;border-radius:50%;border:4px solid rgba(255,255,255,.85);display:flex;flex-direction:column;align-items:center;justify-content:center;margin:.6rem auto;background:rgba(0,0,0,.25);box-shadow:0 0 28px rgba(200,212,0,.4)}
.score-num{font-size:26px;font-weight:700;color:#fff;line-height:1.1}
.score-lbl{font-size:13px;color:rgba(255,255,255,.9);font-weight:600}
.breakdown{display:flex;gap:6px;justify-content:center;flex-wrap:wrap;margin:.6rem 0}
.sb{background:rgba(0,0,0,.25);border-radius:20px;padding:.35rem .9rem;font-size:13px;color:#fff;font-weight:600;border:1px solid rgba(255,255,255,.3)}
.restart-btn{padding:.75rem 2rem;border-radius:12px;border:2px solid rgba(255,255,255,.8);background:rgba(0,0,0,.2);color:#fff;font-size:15px;cursor:pointer;margin-top:.6rem;font-family:inherit;font-weight:700;touch-action:manipulation}
.restart-btn:active{transform:scale(.97)}
.confetti-wrap{position:absolute;top:0;left:0;width:100%;pointer-events:none}
.cf{position:absolute;width:8px;height:8px;border-radius:2px;animation:confettiFall 1.5s ease-in forwards}
@media(max-width:400px){
  .opts{grid-template-columns:1fr}
  .opt{min-height:44px}
  .title{font-size:18px}
  .q-text{font-size:13px}
  #wrap{padding:.75rem}
}
</style>

<div id="wrap"><div id="app"></div></div>

<script>
const TIMER=50;
const levels=[
  {name:"Nivel 1 \u2014 B\u00e1sico",questions:[
    {q:"\u00bfC\u00f3mo describe el texto a la planificaci\u00f3n docente?",opts:[{t:"R\u00edgida y est\u00e1tica",ok:false},{t:"Flexible y continua",ok:true},{t:"Burocrática y fija",ok:false},{t:"Opcional y libre",ok:false}],encourage:"\u00a1Muy bien! Cada paso cuenta."},
    {q:"Seg\u00fan Ruth Harf, \u00bfqu\u00e9 es la planificaci\u00f3n?",opts:[{t:"Un proceso mental escrito",ok:true},{t:"Una lista de temas",ok:false},{t:"Un tr\u00e1mite formal",ok:false},{t:"Un registro de notas",ok:false}],encourage:"\u00a1Excelente! Vas por buen camino."},
    {q:"\u00bfQu\u00e9 riesgo genera NO planificar?",opts:[{t:"Exceso de creatividad",ok:false},{t:"Improvisaci\u00f3n excesiva",ok:true},{t:"Rigidez curricular",ok:false},{t:"Muchas actividades",ok:false}],encourage:"\u00a1Genial! Segu\u00eds avanzando."},
    {q:"\u00bfQui\u00e9nes deben poder ver la planificaci\u00f3n?",opts:[{t:"Solo los alumnos",ok:false},{t:"Solo los padres",ok:false},{t:"Directivos y supervisi\u00f3n",ok:true},{t:"Solo el docente",ok:false}],encourage:"\u00a1Correcto! Tu esfuerzo se nota."},
  ]},
  {name:"Nivel 2 \u2014 Intermedio",questions:[
    {q:"Para Bombini y Labeur, planificar es...",opts:[{t:"Copiar esquemas previos",ok:false},{t:"Imaginaci\u00f3n y decisi\u00f3n",ok:true},{t:"Llenar formularios",ok:false},{t:"Dictar del manual",ok:false}],encourage:"\u00a1Brillante! Cada respuesta te hace m\u00e1s fuerte."},
    {q:"\u00bfQu\u00e9 caracteriza al docente compositor?",opts:[{t:"Sigue el libro al pie",ok:false},{t:"Improvisa sin gu\u00eda",ok:false},{t:"Contextualiza estrategias",ok:true},{t:"Repite lo mismo siempre",ok:false}],encourage:"\u00a1Incre\u00edble! Lo est\u00e1s demostrando."},
    {q:"La educaci\u00f3n bancaria de Freire implica...",opts:[{t:"Debate entre pares",ok:false},{t:"El docente deposita saber",ok:true},{t:"Participaci\u00f3n activa",ok:false},{t:"Planificaci\u00f3n colectiva",ok:false}],encourage:"\u00a1Muy bien pensado! Segu\u00eds creciendo."},
    {q:"\u00bfPara qu\u00e9 sirve plasmar la planificaci\u00f3n escrita?",opts:[{t:"Para el legajo docente",ok:false},{t:"Para que copien alumnos",ok:false},{t:"Analizar coherencia did\u00e1ctica",ok:true},{t:"Reducir carga horaria",ok:false}],encourage:"\u00a1Estupendo! Tu aprendizaje es visible."},
  ]},
  {name:"Nivel 3 \u2014 Avanzado",questions:[
    {q:"El di\u00e1logo de saberes implica que...",opts:[{t:"Solo habla el docente",ok:false},{t:"Todos expresan su saber",ok:true},{t:"Debaten solo colegas",ok:false},{t:"Se ignora lo popular",ok:false}],encourage:"\u00a1Fant\u00e1stico! Est\u00e1s al nivel experto."},
    {q:"Transversar la diversidad cognoscitiva significa...",opts:[{t:"Separar por nivel",ok:false},{t:"Un m\u00e9todo igual para todos",ok:false},{t:"Integrar saber cotidiano",ok:true},{t:"Ignorar diferencias",ok:false}],encourage:"\u00a1Sobresaliente! Comprensi\u00f3n profunda."},
    {q:"Las tres acciones clave del quehacer docente son...",opts:[{t:"Copiar, pegar, entregar",ok:false},{t:"Planificar, gestionar, evaluar",ok:true},{t:"Investigar, publicar, ense\u00f1ar",ok:false},{t:"Dictar, calificar, archivar",ok:false}],encourage:"\u00a1Brillante! Llegaste a lo m\u00e1s alto."},
    {q:"Ense\u00f1ar en t\u00e9rminos de saberes implica...",opts:[{t:"Memorizar teor\u00edas",ok:false},{t:"Solo ex\u00e1menes escritos",ok:false},{t:"Di\u00e1logo entre saberes",ok:true},{t:"Aplicar solo el curr\u00edculo",ok:false}],encourage:"\u00a1Extraordinario! Sos un/a experto/a."},
  ]}
];

let st={screen:"start",lv:0,qi:0,sel:null,answered:false,score:0,lvScores:[0,0,0],timerVal:TIMER,timerInt:null,shuffled:[]};

function shuffleOpts(q){const arr=[...q.opts];for(let i=arr.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[arr[i],arr[j]]=[arr[j],arr[i]];}return arr;}
function prepLevel(lv){st.shuffled=levels[lv].questions.map(q=>({...q,shuffled:shuffleOpts(q)}));}

function startTimer(){
  clearInterval(st.timerInt);st.timerVal=TIMER;updateTimerBar();
  st.timerInt=setInterval(()=>{st.timerVal--;updateTimerBar();if(st.timerVal<=0){clearInterval(st.timerInt);timeOut();}},1000);
}
function updateTimerBar(){
  const bar=document.getElementById("tbar"),lbl=document.getElementById("tlbl");
  if(!bar||!lbl)return;
  bar.style.width=Math.round((st.timerVal/TIMER)*100)+"%";
  lbl.textContent=st.timerVal+"s";
  const c=st.timerVal>20?"rgba(255,255,255,0.9)":st.timerVal>10?"#ffd166":"#ff6b6b";
  bar.style.background=c;lbl.style.color=c;
}
function timeOut(){if(st.answered)return;st.answered=true;st.sel=-1;renderQuiz(true);}

function render(){
  const wrap=document.getElementById("wrap"),app=document.getElementById("app");
  st.screen==="final"?wrap.classList.add("final-bg"):wrap.classList.remove("final-bg");
  if(st.screen==="start"){app.innerHTML=startHTML();return;}
  if(st.screen==="quiz"){app.innerHTML=quizHTML(false);startTimer();return;}
  if(st.screen==="lvEnd"){app.innerHTML=lvEndHTML();return;}
  if(st.screen==="final"){app.innerHTML=finalHTML();launchConfetti();return;}
}
function renderQuiz(t){document.getElementById("app").innerHTML=quizHTML(t);}

function startHTML(){
  return`<div class="start-screen">
    <span class="big-icon">\uD83D\uDCCB</span>
    <h1 class="title">Quiz: Planificaci\u00f3n Docente</h1>
    <p class="sub">3 niveles \u00b7 4 preguntas cada uno<br>\u23F1 50 segundos por pregunta</p>
    <div class="li-row"><div class="li">1</div><div class="li">2</div><div class="li">3</div></div>
    <button class="start-btn" onclick="doStart()">\u00a1Comenzar!</button>
  </div>`;
}

function quizHTML(isTimeout){
  const lv=levels[st.lv],sq=st.shuffled[st.qi],total=lv.questions.length;
  const tc=st.timerVal>20?"rgba(255,255,255,0.9)":st.timerVal>10?"#ffd166":"#ff6b6b";
  const timerW=Math.round((st.timerVal/TIMER)*100);
  const liRow=levels.map((_,i)=>{let c="li";if(i<st.lv)c+=" done";else if(i===st.lv)c+=" active";return`<div class="${c}">${i<st.lv?"\u2713":i+1}</div>`;}).join("");
  const optsHTML=sq.shuffled.map((o,i)=>{let c="opt";if(st.answered||isTimeout){if(o.ok)c+=" reveal";else if(i===st.sel&&!o.ok)c+=" wrong";}return`<button class="${c}" ${st.answered?"disabled":""} onclick="answer(${i})">${o.t}</button>`;}).join("");
  let fb="";
  if(st.answered){
    const ok=st.sel>=0&&sq.shuffled[st.sel]&&sq.shuffled[st.sel].ok;
    if(isTimeout||st.sel===-1)fb=`<div class="feedback timeout">\u23F0 \u00a1Tiempo! La correcta est\u00e1 en verde.<br><em>\u00a1No te rindas!</em></div>`;
    else if(ok)fb=`<div class="feedback ok">\u2713 \u00a1Correcto! <em>${sq.encourage}</em></div>`;
    else{const ct=sq.shuffled.find(o=>o.ok).t;fb=`<div class="feedback ko">\u2717 Incorrecto. Correcta: <strong>${ct}</strong><br><em>\u00a1Segu\u00ed intentando!</em></div>`;}
    fb+=`<button class="next-btn" onclick="nextQ()">${st.qi>=total-1?"Ver resultado \u2192":"Siguiente \u2192"}</button>`;
  }
  return`<div>
    <div class="li-row">${liRow}</div>
    <div class="header"><span class="lvl-badge">${lv.name}</span><span class="score-pill">\u2605 ${st.score} pts</span></div>
    <div class="timer-row">
      <span class="timer-label" id="tlbl" style="color:${tc}">${st.timerVal}s</span>
      <div class="timer-bar-wrap"><div class="timer-bar" id="tbar" style="width:${timerW}%;background:${tc}"></div></div>
    </div>
    <div class="card">
      <p class="q-num">Pregunta ${st.qi+1} de ${total}</p>
      <p class="q-text">${sq.q}</p>
      <div class="opts">${optsHTML}</div>
      ${fb}
    </div>
  </div>`;
}

function lvEndHTML(){
  const ls=st.lvScores[st.lv-1],total=levels[st.lv-1].questions.length,pct=Math.round((ls/total)*100),isLast=st.lv>=levels.length;
  return`<div class="level-complete">
    <span class="big-icon">\uD83D\uDE0A</span>
    <h2 class="title">\u00a1${levels[st.lv-1].name} superado!</h2>
    <p class="lvl-score">${ls} de ${total} correctas \u00b7 ${pct}%</p>
    ${isLast?`<button class="cont-btn" onclick="showFinal()">Ver puntaje final \u2192</button>`:`<button class="cont-btn" onclick="nextLevel()">Nivel ${st.lv+1} \u2192</button>`}
  </div>`;
}

function getStars(p){return p>=90?"\u2B50\u2B50\u2B50":p>=60?"\u2B50\u2B50":"\u2B50";}
function getMsg(p){return p>=90?"\u00a1Sobresaliente! Sos un/a crack \uD83C\uDF93":p>=60?"\u00a1Muy bien! Gran dominio \uD83D\uDCAA":p>=40?"\u00a1Buen intento! Segu\u00ed practicando \uD83D\uDCDA":"\u00a1No te rindas! Intent\u00e1lo de nuevo \uD83D\uDD25";}
function getIcon(p){return p>=90?"\uD83C\uDFC6":p>=60?"\uD83C\uDF89":p>=40?"\uD83D\uDE0A":"\uD83D\uDCA1";}

function finalHTML(){
  const total=levels.reduce((s,l)=>s+l.questions.length,0),pct=Math.round((st.score/total)*100);
  const bd=st.lvScores.map((ls,i)=>`<div class="sb">Nivel ${i+1}: ${ls}/${levels[i].questions.length}</div>`).join("");
  return`<div class="final">
    <div class="confetti-wrap" id="cfwrap"></div>
    <span class="final-icon">${getIcon(pct)}</span>
    <div class="stars">${getStars(pct)}</div>
    <h2 class="final-title">${getMsg(pct)}</h2>
    <p class="final-sub">Completaste el quiz de Planificaci\u00f3n Docente</p>
    <div class="score-circle"><span class="score-num">${st.score}/${total}</span><span class="score-lbl">${pct}%</span></div>
    <div class="breakdown">${bd}</div>
    <button class="restart-btn" onclick="doRestart()">\uD83D\uDD04 Volver a jugar</button>
  </div>`;
}

function launchConfetti(){
  setTimeout(()=>{
    const wrap=document.getElementById("cfwrap");
    if(!wrap)return;
    const colors=["#c8d400","#4a9e20","#0d5c3a","#00e5ff","#ffffff","#a8e063"];
    for(let i=0;i<28;i++){
      const el=document.createElement("div");
      el.className="cf";
      el.style.left=Math.random()*100+"%";
      el.style.top="-10px";
      el.style.background=colors[Math.floor(Math.random()*colors.length)];
      el.style.animationDelay=Math.random()*1.2+"s";
      el.style.animationDuration=(1+Math.random())+"s";
      el.style.borderRadius=Math.random()>0.5?"50%":"2px";
      wrap.appendChild(el);
    }
  },100);
}

function doStart(){st={screen:"quiz",lv:0,qi:0,sel:null,answered:false,score:0,lvScores:[0,0,0],timerVal:TIMER,timerInt:null,shuffled:[]};prepLevel(0);render();}
function answer(i){if(st.answered)return;clearInterval(st.timerInt);st.answered=true;st.sel=i;const sq=st.shuffled[st.qi];if(sq.shuffled[i].ok){const ls=[...st.lvScores];ls[st.lv]++;st.lvScores=ls;st.score++;}renderQuiz(false);}
function nextQ(){const total=levels[st.lv].questions.length;if(st.qi<total-1){st={...st,qi:st.qi+1,sel:null,answered:false,timerVal:TIMER};render();}else{st={...st,lv:st.lv+1,screen:"lvEnd",qi:0,sel:null,answered:false};clearInterval(st.timerInt);render();}}
function nextLevel(){prepLevel(st.lv);st={...st,screen:"quiz",qi:0,sel:null,answered:false,timerVal:TIMER};render();}
function showFinal(){st={...st,screen:"final"};render();}
function doRestart(){clearInterval(st.timerInt);st={screen:"start",lv:0,qi:0,sel:null,answered:false,score:0,lvScores:[0,0,0],timerVal:TIMER,timerInt:null,shuffled:[]};render();}

render();
</script>
